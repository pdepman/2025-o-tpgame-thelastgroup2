import Personajes.*
import Obstaculos.*
import camara.*
import wollok.game.*

program AventurasDelAventurero { 
    game.title("Aventureando") // no esta el titulo definido, aún
    game.height(50)
    game.width(90)
    game.cellSize(10) 

    
    
    
    game.addVisual(fondoJuego) // se implementa al fondo como una imagen no estatica para el side scrolling
    
    game.addVisualCharacter(fin)
    game.addVisual(muro)
    game.addVisual(pocionVida) 
    game.addVisual(fogata)
    game.addVisual(matafuegos)
    game.addVisual(final)
    game.addVisual(barraVida)
    
    // Inicializar posiciones de objetos según la cámara
    camara.actualizarPosicionObjetos()
    

    //  movimiento
    keyboard.left().onPressDo({ fin.moverIzquierda() })
    keyboard.right().onPressDo({ fin.moverDerecha() })
    keyboard.up().onPressDo({ fin.moverArriba() }) // quiza hay que re-modicar debido a que se añadirá saltos
    keyboard.down().onPressDo({ fin.moverAbajo() }) // quiza hay que re-modicar debido a que se añadirá saltos

    game.start()

    game.onCollideDo(fin, {item => fin.obtenerItem(item)})

      //  ontick --> ejecuta un bloque en un intervalo (aplica a saltos)
       
       // cargar assets:
        // pasto
        // matafuego
        // tijeras
        // pocion de vida y/o fuerza
      //game . vissuals in --> comprueba si puedo moverme si no hay obstaculos en la siguiente celda (OPTIMO PARA SALTOS EN DISTINTAS LINEAS)
        // game . distance --> avisa la distancia entre 2 objetos
        //APLICAR --> el personaje deba tocar una tecla e interactue con el objeto / obstaculo
        // APLICAR --> ALGUN CHECKPOINT (QUE COMPLETE UN NIVEL)
        // GAME . CLEANER (LIMPIA LA PANTALLA)
        // OBJETOS - DIRECCION 
        // POLIMORFISMO DIRECCION
}
